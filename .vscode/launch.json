{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex-Debug (PyOCD) - Flash & Debug",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/HAL_TEST_Board.elf",
            "servertype": "pyocd",
            "device": "stm32f103ze",
            "targetId": "stm32f103ze",
            "interface": "swd",
            // SVD 文件：调试时显示外设寄存器
            "svdFile": "${workspaceFolder}/Drivers/svd/STM32F103xx.svd",
            "runToMain": true,
            // 调试前自动编译 + 烧录
            "preLaunchTask": "PYOCD Flash",
            // pyOCD GDB Server 附加参数
            "serverArgs": [
                "--connect", "under-reset"
            ],
            // 匹配 pyocd gdbserver 的就绪输出文本，解决超时问题
            "overrideGDBServerStartedRegex": "GDB server listening on port",
            "gdbPath": "arm-none-eabi-gdb",
            // 实时变量监视
            "liveWatch": {
                "enabled": true,
                "samplePeriod": 20
            },
            "rttConfig": {
                "enabled": false
            }
        },
        {
            "name": "Cortex-Debug (PyOCD) - Attach (running)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/HAL_TEST_Board.elf",
            "servertype": "pyocd",
            "device": "stm32f103ze",
            "targetId": "stm32f103ze",
            "interface": "swd",
            // SVD 文件：调试时显示外设寄存器
            "svdFile": "${workspaceFolder}/Drivers/svd/STM32F103xx.svd",
            // 匹配 pyocd gdbserver 的就绪输出文本，解决超时问题
            "overrideGDBServerStartedRegex": "GDB server listening on port",
            "gdbPath": "arm-none-eabi-gdb",
            // Attach 后自动暂停目标
            "postAttachCommands": [
                "monitor reset halt"
            ],
            "liveWatch": {
                "enabled": true,
                "samplePeriod": 20
            },
            "rttConfig": {
                "enabled": false
            }
        }
    ]
}
